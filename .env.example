# ============================================================
# ERP Backend .env.example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
BASE_URL=http://localhost:4000

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=erp
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_REQUEST_TIMEOUT=30000
DB_CONNECTION_POOL_SIZE=10

# --- Session / Auth ---
SESSION_SECRET=change-me-to-a-32-char-random-string
SESSION_NAME=erp.sid
SESSION_MAX_AGE_HOURS=12
CSRF_SECRET=change-me-to-another-32-char-random-string

# --- Security ---
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# --- First-run setup ---
# Set to "true" once the first-time setup (company + first admin) has been completed.
SETUP_COMPLETED=false
